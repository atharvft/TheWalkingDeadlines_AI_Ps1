# Hinglish Order Desk - Environment Variables Example

# Application
APP_NAME=hinglish-order-desk
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# Database
DATABASE_URL=sqlite:///backend/data/orderdesk.db

# AI/ML
ASR_MODEL=whisper-base
NLP_MODEL=hindi-english-mixed
MATCHING_THRESHOLD=0.75

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api

# Logging
LOG_LEVEL=INFO