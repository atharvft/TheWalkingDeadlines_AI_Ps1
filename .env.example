# Hinglish Order Desk - Environment Variables Example

# Application
APP_NAME=hinglish-order-desk
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# Database
DATABASE_URL=sqlite:///backend/data/orderdesk.db

# Backend-only AI credentials. Never expose these through VITE_ or NEXT_PUBLIC_.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
TRANSCRIPTION_PROVIDER=gemini
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
MATCHING_THRESHOLD=0.75
CATALOG_PATH=data/catalog/products.json
RAW_CATALOG_PATH=data/raw/bigbasket.csv
MAX_AUDIO_BYTES=26214400
AI_REQUEST_TIMEOUT_SECONDS=30

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Logging
LOG_LEVEL=INFO
